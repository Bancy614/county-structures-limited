{
  "name": "Service",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Development Consultancy",
        "Construction Services"
      ],
      "default": "Construction Services"
    },
    "short_description": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon_name": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "process_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "display_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}